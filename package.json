{
  "name": "yootor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-pdf.mjs && next dev --hostname 0.0.0.0",
    "build": "node scripts/prepare-pdf.mjs && prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests docs README.md package.json tsconfig.json next.config.ts",
    "test:postgres": "tsx tests/postgres-smoke.ts",
    "postinstall": "node scripts/prepare-pdf.mjs",
    "test:production": "node tests/production-smoke.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.2",
    "@prisma/client": "6.12.0",
    "@radix-ui/react-dialog": "1.3.1",
    "clsx": "2.1.1",
    "lucide-react": "1.68.0",
    "motion": "14.9.1",
    "next": "16.4.5",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.10",
    "prisma": "6.12.0",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22.13.0 <23 || >=24"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
  }
}
