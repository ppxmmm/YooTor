# For local PostgreSQL, replace PASSWORD with the password from docker-compose.yml.
# For Supabase, use the session pooler connection string from the project's
# Connect dialog. Keep the real connection string in .env, never in this file.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Required in production: 32 random bytes encoded as 64 hexadecimal characters.
# DATA_ENCRYPTION_KEY=""

# Required in production: the exact public HTTPS origin, without a trailing slash.
# APP_ORIGIN="https://example.com"
